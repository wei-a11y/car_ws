Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    # Debug frame only. Set to the actual OccupancyGrid header.frame_id in RViz.
    Fixed Frame: grid_debug
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Raw Grid
      Enabled: true
      Alpha: 0.5
      Topic:
        Value: /plan/raw_grid
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Inflated Grid
      Enabled: true
      Alpha: 0.7
      Topic:
        Value: /plan/inflated_grid
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Processed Path
      Enabled: true
      Color: 25; 255; 50
      Alpha: 1
      Line Style: Lines
      Line Width: 0.03
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Raw AStar Path
      Enabled: true
      Color: 255; 170; 25
      Alpha: 0.8
      Line Style: Lines
      Line Width: 0.02
      Topic:
        Value: /plan/raw_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 60
