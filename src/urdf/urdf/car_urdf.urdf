      <parameters>$(find car_description)/config/controllers.yaml</parameters>
      <!-- 添加话题映射 -->
      <ros>
        <remapping>/diff_drive_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
        <remapping>/diff_drive_controller/odom:=/odom</remapping>
        <remapping>/dynamic_ states:=/car/dynamic_ states</remapping>
      </ros>
    </plugin>
  </gazebo>

